# Fournisseur : "mistral" (API Mistral directe) ou "openrouter"
FOURNISSEUR=mistral

# --- API Mistral directe : clé sur https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Modèles par défaut : mistral-medium-latest (générateur), mistral-large-latest (juge),
# mistral-embed (embeddings). À surcharger si besoin :
# MODELE=mistral-small-latest

# --- OpenRouter : clé sur https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Modèles par défaut : mistralai/mistral-medium-3-5, mistralai/mistral-large-4-0,
# mistralai/mistral-embed-2312

# Vide = BM25 seul (pas d'embeddings) :
# MODELE_EMBEDDING=

# Appels au juge en parallèle (1 si l'offre gratuite Mistral renvoie des erreurs 429)
# JUGE_PARALLELES=4

# Jeton de l'API HTTP (serveur sur le VPS)
API_TOKEN=change-moi
