OPENROUTER_API_KEY=sk-or-v1-...
# Générateur et juge : deux modèles différents pour limiter l'auto-complaisance du juge.
MODELE=mistralai/mistral-medium-3-5
MODELE_JUGE=mistralai/mistral-large-4-0
# Vide = BM25 seul. mistral-embed est disponible via OpenRouter (/api/v1/embeddings).
MODELE_EMBEDDING=mistralai/mistral-embed-2312
# Jeton de l'API HTTP (serveur sur le VPS)
API_TOKEN=change-moi
